+
+namespace {
+
+constexpr char16_t kTitle[] = u"Patch notes";
+constexpr int kWidth = 440;
+constexpr int kMaxHeight = 480;
+constexpr int kReleaseSpacing = 16;
+constexpr int kLineSpacing = 4;
+
+// GitHub release notes are Markdown. Show them as readable plain text:
+// headings lose their #s, list items get bullets, and **bold** markers go.
+std::u16string MarkdownToPlainText(const std::u16string& markdown) {
+  std::vector<std::u16string> lines;
+  for (std::u16string_view line : base::SplitStringPiece(
+           markdown, u"\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    std::u16string text(base::TrimWhitespace(line, base::TRIM_TRAILING));
+    std::u16string_view trimmed =
+        base::TrimWhitespace(text, base::TRIM_LEADING);
+    if (base::StartsWith(trimmed, u"#")) {
+      const size_t start = trimmed.find_first_not_of(u'#');
+      trimmed = start == std::u16string_view::npos ? std::u16string_view()
+                                                   : trimmed.substr(start);
+      text = std::u16string(base::TrimWhitespace(trimmed, base::TRIM_LEADING));
+    } else if (base::StartsWith(trimmed, u"- ") ||
+               base::StartsWith(trimmed, u"* ")) {
+      text = base::StrCat({u"• ", trimmed.substr(2)});
+    }
+    base::ReplaceSubstringsAfterOffset(&text, 0, u"**", u"");
+    lines.push_back(std::move(text));
+  }
+  return std::u16string(
+      base::TrimWhitespace(base::JoinString(lines, u"\n"), base::TRIM_ALL));
+}
+
+std::unique_ptr<views::Label> MakeLabel(const std::u16string& text,
+                                        int style) {
+  auto label = std::make_unique<views::Label>(
+      text, views::style::CONTEXT_DIALOG_BODY_TEXT, style);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetMultiLine(true);
+  label->SetAllowCharacterBreak(true);
+  label->SizeToFit(kWidth);
+  return label;
+}
+
+}  // namespace
+
+ArchiePatchNotes::ArchiePatchNotes(BrowserWindowInterface* browser)
+    : browser_(browser) {}
+
+ArchiePatchNotes::~ArchiePatchNotes() {
+  if (widget_) {
+    widget_->CloseNow();
+  }
+}
+
+void ArchiePatchNotes::Show(views::View* anchor) {
+  if (widget_) {
+    widget_->Activate();
+    return;
+  }
+
+  delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+      anchor, views::BubbleBorder::FLOAT);
+  delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate_->SetTitle(std::u16string(kTitle));
+  delegate_->SetShowCloseButton(true);
+
+  auto scroll_view = std::make_unique<views::ScrollView>();
+  scroll_view->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_view->ClipHeightTo(0, kMaxHeight);
+  auto list = std::make_unique<views::BoxLayoutView>();
+  list->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  list->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kStart);
+  list_ = scroll_view->SetContents(std::move(list));
+  delegate_->SetContentsView(std::move(scroll_view));
+
+  ArchieUpdateChecker* checker = ArchieUpdateChecker::Get();
+  checker_subscription_ = checker->RegisterCallback(base::BindRepeating(
+      &ArchiePatchNotes::Rebuild, weak_factory_.GetWeakPtr()));
+  if (checker->state() == ArchieUpdateChecker::State::kNotChecked) {
+    checker->Check(/*force=*/false);
+  }
+  Rebuild();
+
+  widget_ = views::BubbleDialogDelegate::CreateBubble(
+      delegate_.get(), base::BindOnce(&ArchiePatchNotes::OnWidgetClosed,
+                                      weak_factory_.GetWeakPtr()));
+  widget_->Show();
+}
+
+void ArchiePatchNotes::Rebuild() {
+  if (!list_) {
+    return;
+  }
+  list_->RemoveAllChildViews();
+  const ArchieUpdateChecker* checker = ArchieUpdateChecker::Get();
+
+  list_->AddChildView(MakeLabel(
+      base::StrCat({u"You're on Archie ",
+                    base::UTF8ToUTF16(
+                        ArchieUpdateChecker::CurrentVersion().GetString()),
+                    u"."}),
+      views::style::STYLE_SECONDARY));
+
+  if (const ArchieRelease* update = checker->GetAvailableUpdate()) {
+    const std::u16string version =
+        base::UTF8ToUTF16(update->version.GetString());
+    list_->AddChildView(
+        MakeLabel(base::StrCat({u"Archie ", version, u" is available."}),
+                  views::style::STYLE_EMPHASIZED));
+    auto download = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&ArchiePatchNotes::OpenUrl,
+                            weak_factory_.GetWeakPtr(), update->url),
+        u"Get the update");
+    download->SetProperty(views::kMarginsKey,
+                          gfx::Insets::TLBR(kLineSpacing, 0, 0, 0));
+    list_->AddChildView(std::move(download));
+  }
+
+  if (checker->releases().empty()) {
+    std::u16string message;
+    switch (checker->state()) {
+      case ArchieUpdateChecker::State::kNotChecked:
+      case ArchieUpdateChecker::State::kChecking:
+        message = u"Checking GitHub for releases…";
+        break;
+      case ArchieUpdateChecker::State::kFailed:
+        message =
+            u"Couldn't reach GitHub. Try again later with Check for updates.";
+        break;
+      case ArchieUpdateChecker::State::kDone:
+        message = u"No releases have been published yet.";
+        break;
+    }
+    auto label = MakeLabel(message, views::style::STYLE_PRIMARY);
+    label->SetProperty(views::kMarginsKey,
+                       gfx::Insets::TLBR(kReleaseSpacing, 0, 0, 0));
+    list_->AddChildView(std::move(label));
+  }
+
+  for (const ArchieRelease& release : checker->releases()) {
+    std::u16string heading = release.title;
+    if (!release.date.empty()) {
+      heading = base::StrCat({heading, u"  ·  ", release.date});
+    }
+    auto title = MakeLabel(heading, views::style::STYLE_EMPHASIZED);
+    title->SetProperty(views::kMarginsKey,
+                       gfx::Insets::TLBR(kReleaseSpacing, 0, kLineSpacing, 0));
+    list_->AddChildView(std::move(title));
+
+    const std::u16string notes = MarkdownToPlainText(release.notes);
+    list_->AddChildView(
+        MakeLabel(notes.empty() ? u"No notes for this release." : notes,
+                  views::style::STYLE_PRIMARY));
+  }
+
+  list_->AddChildView(std::make_unique<views::LabelButton>(
+          base::BindRepeating(&ArchiePatchNotes::OpenUrl,
+                              weak_factory_.GetWeakPtr(),
+                              ArchieUpdateChecker::ReleasesPageUrl()),
+          u"All releases on GitHub"))
+      ->SetProperty(views::kMarginsKey,
+                    gfx::Insets::TLBR(kReleaseSpacing, 0, 0, 0));
+
+  if (widget_) {
+    delegate_->SizeToContents();
+  }
+}
+
+void ArchiePatchNotes::OpenUrl(const GURL& url) {
+  NavigateParams params(browser_.get(), url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  if (widget_) {
+    widget_->Close();
+  }
+}
+
+void ArchiePatchNotes::OnWidgetClosed(views::Widget::ClosedReason reason) {
+  checker_subscription_ = {};
+  list_ = nullptr;
+  // The widget may still be unwinding, and the delegate must outlive it, so
+  // destroy both later, widget first.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::unique_ptr<views::BubbleDialogDelegate> delegate,
+             std::unique_ptr<views::Widget> widget) { widget.reset(); },
+          std::move(delegate_), std::move(widget_)));
+}
