+
+constexpr char16_t kPlaceholder[] = u"Search or type a URL";
+constexpr char16_t kSeparator[] = u" — ";  // em dash
+constexpr int kFontSizeDelta = 4;
+constexpr int kWidthInChars = 40;
+constexpr size_t kMaxRows = 6;
+constexpr int kRowIconSize = 16;
+constexpr int kRowCornerRadius = 8;
+constexpr int kListTopSpacing = 8;
+const gfx::Insets kRowInsets = gfx::Insets::VH(6, 8);
+
+}  // namespace
+
+ArchieCommandBar::ArchieCommandBar(BrowserWindowInterface* browser)
+    : browser_(browser) {}
+
+ArchieCommandBar::~ArchieCommandBar() {
+  if (widget_) {
+    widget_->CloseNow();
+  }
+}
+
+void ArchieCommandBar::Show(views::View* anchor) {
+  if (widget_) {
+    widget_->Activate();
+    textfield_->RequestFocus();
+    return;
+  }
+
+  Profile* profile = browser_->GetProfile();
+  autocomplete_controller_ = std::make_unique<AutocompleteController>(
+      std::make_unique<ChromeAutocompleteProviderClient>(profile),
+      AutocompleteControllerConfig{
+          .provider_types = AutocompleteClassifier::DefaultOmniboxProviders(),
+          .show_iph_matches = false});
+  autocomplete_observation_.Observe(autocomplete_controller_.get());
+
+  delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+      anchor, views::BubbleBorder::FLOAT);
+  delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate_->SetShowTitle(false);
+  delegate_->SetShowCloseButton(false);
+
+  auto contents = std::make_unique<views::BoxLayoutView>();
+  contents->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  contents->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+
+  auto textfield = std::make_unique<views::Textfield>();
+  textfield->SetController(this);
+  textfield->SetPlaceholderText(kPlaceholder);
+  textfield->GetViewAccessibility().SetName(std::u16string(kPlaceholder));
+  textfield->SetFontList(
+      views::Textfield::GetDefaultFontList().DeriveWithSizeDelta(
+          kFontSizeDelta));
+  textfield->SetDefaultWidthInChars(kWidthInChars);
+  textfield_ = contents->AddChildView(std::move(textfield));
+
+  auto suggestion_list = std::make_unique<views::BoxLayoutView>();
+  suggestion_list->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  suggestion_list->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  suggestion_list->SetInsideBorderInsets(
+      gfx::Insets::TLBR(kListTopSpacing, 0, 0, 0));
+  suggestion_list->SetVisible(false);
+  suggestion_list_ = contents->AddChildView(std::move(suggestion_list));
+
+  delegate_->SetContentsView(std::move(contents));
+  delegate_->SetInitiallyFocusedView(textfield_);
+
+  widget_ = views::BubbleDialogDelegate::CreateBubble(
+      delegate_.get(), base::BindOnce(&ArchieCommandBar::OnWidgetClosed,
+                                      weak_factory_.GetWeakPtr()));
+  widget_->Show();
+}
+
+void ArchieCommandBar::ContentsChanged(views::Textfield* sender,
+                                       const std::u16string& new_contents) {
+  if (!autocomplete_controller_) {
+    return;
+  }
+  if (base::TrimWhitespace(new_contents, base::TRIM_ALL).empty()) {
+    autocomplete_controller_->Stop(AutocompleteStopReason::kClobbered);
+    matches_.clear();
+    RebuildSuggestionRows();
+    return;
+  }
+
+  Profile* profile = browser_->GetProfile();
+  AutocompleteInput input(new_contents, metrics::OmniboxEventProto::OTHER,
+                          ChromeAutocompleteSchemeClassifier(profile));
+  // Suggestions are listed below the box; never rewrite what was typed.
+  input.set_prevent_inline_autocomplete(true);
+  autocomplete_controller_->Start(input);
+}
+
+bool ArchieCommandBar::HandleKeyEvent(views::Textfield* sender,
+                                      const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  switch (key_event.key_code()) {
+    case ui::VKEY_DOWN:
+      SelectRow(selected_row_ + 1);
+      return true;
+    case ui::VKEY_UP:
+      SelectRow(selected_row_ - 1);
+      return true;
+    case ui::VKEY_RETURN:
+      if (selected_row_ >= 0 &&
+          static_cast<size_t>(selected_row_) < matches_.size()) {
+        OpenMatch(matches_[selected_row_]);
+      } else {
+        OpenTypedText(sender->GetText());
+      }
+      return true;
+    default:
+      return false;
+  }
+}
+
+void ArchieCommandBar::OnResultChanged(AutocompleteController* controller,
+                                       bool default_match_changed) {
+  matches_.clear();
+  for (const AutocompleteMatch& match : controller->result()) {
+    if (matches_.size() == kMaxRows) {
+      break;
+    }
+    if (match.destination_url.is_valid()) {
+      matches_.push_back(match);
+    }
+  }
+  RebuildSuggestionRows();
+}
+
+void ArchieCommandBar::RebuildSuggestionRows() {
+  if (!suggestion_list_) {
+    return;
+  }
+  suggestion_rows_.clear();
+  suggestion_list_->RemoveAllChildViews();
+
+  for (size_t i = 0; i < matches_.size(); ++i) {
+    const AutocompleteMatch& match = matches_[i];
+    std::u16string text = match.contents;
+    if (!match.description.empty()) {
+      text += kSeparator;
+      text += match.description;
+    }
+    auto row = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&ArchieCommandBar::OnRowPressed,
+                            weak_factory_.GetWeakPtr(), i),
+        text);
+    const gfx::VectorIcon& icon = AutocompleteMatch::IsSearchType(match.type)
+                                      ? vector_icons::kLucideSearchIcon
+                                      : vector_icons::kLucideGlobeIcon;
+    row->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(icon, ui::kColorIcon, kRowIconSize));
+    row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    row->SetElideBehavior(gfx::ELIDE_TAIL);
+    row->SetTooltipText(text);
+    row->SetBorder(views::CreateEmptyBorder(kRowInsets));
+    suggestion_rows_.push_back(suggestion_list_->AddChildView(std::move(row)));
+  }
+
+  suggestion_list_->SetVisible(!matches_.empty());
+  selected_row_ = -1;
+  SelectRow(0);
+  delegate_->SizeToContents();
+}
+
+void ArchieCommandBar::SelectRow(int row) {
+  if (suggestion_rows_.empty()) {
+    selected_row_ = -1;
+    return;
+  }
+  row = std::clamp(row, 0, static_cast<int>(suggestion_rows_.size()) - 1);
+  if (selected_row_ >= 0 &&
+      static_cast<size_t>(selected_row_) < suggestion_rows_.size()) {
+    suggestion_rows_[selected_row_]->SetBackground(nullptr);
+  }
+  selected_row_ = row;
+  suggestion_rows_[selected_row_]->SetBackground(
+      views::CreateRoundedRectBackground(
+          kColorTabBackgroundInactiveHoverFrameActive, kRowCornerRadius));
+}
+
+void ArchieCommandBar::OnRowPressed(size_t row) {
+  if (row < matches_.size()) {
+    OpenMatch(matches_[row]);
+  }
+}
+
+void ArchieCommandBar::OpenMatch(const AutocompleteMatch& match) {
+  // Copy what is needed first: navigating can update `matches_`.
+  const GURL url = match.destination_url;
+  const ui::PageTransition transition = match.transition;
+  NavigateParams params(browser_.get(), url, transition);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+
+  // Closes asynchronously, so it is safe while handling a key or click. The
+  // new tab may already have closed it by taking activation.
+  if (widget_) {
+    widget_->Close();
+  }
+}
+
+void ArchieCommandBar::OpenTypedText(std::u16string_view input) {
+  const std::u16string text(base::TrimWhitespace(input, base::TRIM_ALL));
+  if (text.empty()) {
+    return;
+  }
+  // Let the omnibox decide whether this is an address or a search, exactly as
+  // if it had been typed into the location bar.
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile())
+      ->Classify(text, /*in_keyword_mode=*/false,
+                 /*allow_exact_keyword_match=*/false,
+                 metrics::OmniboxEventProto::OTHER, &match,
+                 /*alternate_nav_url=*/nullptr);
+  if (match.destination_url.is_valid()) {
+    OpenMatch(match);
+  }
+}
+
+void ArchieCommandBar::OnWidgetClosed(views::Widget::ClosedReason reason) {
+  autocomplete_observation_.Reset();
+  if (autocomplete_controller_) {
+    autocomplete_controller_->Stop(AutocompleteStopReason::kClobbered);
+  }
+  matches_.clear();
+  suggestion_rows_.clear();
+  suggestion_list_ = nullptr;
+  if (textfield_) {
+    textfield_->SetController(nullptr);
+    textfield_ = nullptr;
+  }
+  // The widget may still be unwinding, and the delegate must outlive it, so
+  // destroy both later, widget first. The autocomplete controller can go
+  // with them.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::unique_ptr<AutocompleteController> controller,
+             std::unique_ptr<views::BubbleDialogDelegate> delegate,
+             std::unique_ptr<views::Widget> widget) { widget.reset(); },
+          std::move(autocomplete_controller_), std::move(delegate_),
+          std::move(widget_)));
+}
