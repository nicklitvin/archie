+void VerticalTabStripBottomContainer::AddNavigationButton(
+    actions::ActionId action_id,
+    const gfx::VectorIcon& icon,
+    int tooltip_id) {
+  actions::ActionItem* action_item =
+      actions::ActionManager::Get().FindAction(action_id, root_action_item_);
+  CHECK(action_item);
+  // These actions are registered without an icon or tooltip because the
+  // toolbar's buttons set their own; give them what a sidebar button needs.
+  const std::u16string tooltip = l10n_util::GetStringUTF16(tooltip_id);
+  action_item->SetImage(ui::ImageModel::FromVectorIcon(icon, ui::kColorIcon));
+  action_item->SetTooltipText(tooltip);
+  action_item->SetAccessibleName(tooltip);
+
+  auto button = std::make_unique<TopContainerButton>();
+  action_view_controller_->CreateActionViewRelationship(
+      button.get(), action_item->GetAsWeakPtr());
+  button_row_->AddChildView(std::move(button));
+}
+
+void VerticalTabStripBottomContainer::ShowCommandBar() {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  CHECK(browser_view);
+  if (!command_bar_) {
+    command_bar_ = std::make_unique<ArchieCommandBar>(browser_);
+  }
+  command_bar_->Show(browser_view->contents_container());
+}
+
+void VerticalTabStripBottomContainer::ActivatePreviousTab() {
+  tabs::TabInterface* tab = previous_tab_.Get();
+  if (!tab) {
+    return;
+  }
+  TabStripModel* tab_strip_model = browser_->GetTabStripModel();
+  const int index = tab_strip_model->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab) {
+    tab_strip_model->ActivateTabAt(index);
+  }
+}
+
+void VerticalTabStripBottomContainer::ScrollToActiveTab() {
+  tabs::TabInterface* active_tab = browser_->GetTabStripModel()->GetActiveTab();
+  if (!active_tab) {
+    return;
+  }
+  for (views::View* view = parent(); view; view = view->parent()) {
+    if (auto* region = views::AsViewClass<VerticalTabStripRegionView>(view)) {
+      if (views::View* tab_view =
+              region->GetTabAnchorView(active_tab->GetHandle())) {
+        tab_view->ScrollViewToVisible();
+      }
+      return;
+    }
+  }
+}
+
+void VerticalTabStripBottomContainer::UpdatePreviousTabPill() {
+  TabStripModel* tab_strip_model = browser_->GetTabStripModel();
+  tabs::TabInterface* tab = previous_tab_.Get();
+  const bool show = tab && tab != tab_strip_model->GetActiveTab() &&
+                    tab_strip_model->GetIndexOfTab(tab) !=
+                        TabStripModel::kNoTab &&
+                    tab->GetContents();
+  previous_tab_pill_->SetVisible(show);
+  if (!show) {
+    return;
+  }
+
+  content::WebContents* contents = tab->GetContents();
+  std::u16string title = contents->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+  }
+  previous_tab_pill_->SetText(title);
+  previous_tab_pill_->SetTooltipText(title);
+
+  favicon::ContentFaviconDriver* favicon_driver =
+      favicon::ContentFaviconDriver::FromWebContents(contents);
+  previous_tab_pill_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      favicon_driver && favicon_driver->FaviconIsValid()
+          ? ui::ImageModel::FromImage(favicon_driver->GetFavicon())
+          : ui::ImageModel::FromVectorIcon(vector_icons::kLucideGlobeIcon,
+                                           ui::kColorIcon, kPillIconSize));
+}
+
+void VerticalTabStripBottomContainer::ExecuteCommand(int command_id,
+                                                     int event_flags) {
+  switch (command_id) {
+    case kPatchNotesCommand:
+      ShowPatchNotes();
+      break;
+    case kCheckForUpdatesCommand:
+      ArchieUpdateChecker::Get()->Check(/*force=*/true);
+      ShowPatchNotes();
+      break;
+    case kBrowserSettingsCommand: {
+      NavigateParams params(browser_.get(), GURL(kBrowserSettingsUrl),
+                            ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+      params.disposition = WindowOpenDisposition::SINGLETON_TAB;
+      Navigate(&params);
+      break;
+    }
+  }
+}
+
+void VerticalTabStripBottomContainer::ShowSettingsMenu() {
+  // Keep an expand-on-hover sidebar open while the menu is showing.
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  if (browser_view && browser_view->tab_strip_view()) {
+    expand_on_hover_lock_ =
+        browser_view->tab_strip_view()->GetExpandOnHoverLock(
+            ExpandOnHoverLockType::kKeepCurrentState);
+  }
+  // Closing the menu releases the lock, same as the new tab context menu.
+  settings_menu_runner_ = std::make_unique<views::MenuRunner>(
+      settings_menu_model_.get(), views::MenuRunner::HAS_MNEMONICS,
+      base::BindRepeating(
+          &VerticalTabStripBottomContainer::OnNewTabButtonContextMenuClosed,
+          base::Unretained(this)));
+  settings_menu_runner_->RunMenuAt(
+      GetWidget(), nullptr, settings_button_->GetAnchorBoundsInScreen(),
+      views::MenuAnchorPosition::kBubbleTopLeft,
+      ui::mojom::MenuSourceType::kNone);
+}
+
+void VerticalTabStripBottomContainer::ShowPatchNotes() {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  CHECK(browser_view);
+  if (!patch_notes_) {
+    patch_notes_ = std::make_unique<ArchiePatchNotes>(browser_);
+  }
+  patch_notes_->Show(browser_view->contents_container());
+}
+
+void VerticalTabStripBottomContainer::UpdateUpdateWarning() {
+  const ArchieRelease* update =
+      ArchieUpdateChecker::Get()->GetAvailableUpdate();
+  update_warning_->SetVisible(update != nullptr);
+  if (!update) {
+    return;
+  }
+  const std::u16string tooltip =
+      base::StrCat({u"Archie ", base::UTF8ToUTF16(update->version.GetString()),
+                    u" is available. Click to see what's new."});
+  update_warning_->SetTooltipText(tooltip);
+  update_warning_->GetViewAccessibility().SetName(tooltip);
+  // Icon only when the sidebar is collapsed.
+  update_warning_->SetText(collapsed_ ? std::u16string() : kUpdateAvailable);
+}
