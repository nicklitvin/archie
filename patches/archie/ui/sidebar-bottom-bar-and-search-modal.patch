+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARCHIE_UPDATE_CHECKER_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARCHIE_UPDATE_CHECKER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/version.h"
+#include "url/gurl.h"
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+// One published Archie release on GitHub.
+struct ArchieRelease {
+  ArchieRelease();
+  ArchieRelease(const ArchieRelease&);
+  ArchieRelease& operator=(const ArchieRelease&);
+  ~ArchieRelease();
+
+  base::Version version;
+  std::u16string title;
+  // YYYY-MM-DD.
+  std::u16string date;
+  // The release notes, as written on GitHub (Markdown).
+  std::u16string notes;
+  GURL url;
+};
+
+// Archie: checks the GitHub releases of the Archie repository for a version
+// newer than the one running, and keeps the release list for the patch notes.
+// One instance is shared by all windows. It checks when first asked, then
+// every six hours; Check(/*force=*/true) checks right away.
+class ArchieUpdateChecker {
+ public:
+  enum class State { kNotChecked, kChecking, kDone, kFailed };
+
+  static ArchieUpdateChecker* Get();
+
+  ArchieUpdateChecker(const ArchieUpdateChecker&) = delete;
+  ArchieUpdateChecker& operator=(const ArchieUpdateChecker&) = delete;
+
+  // The version of Archie that is running.
+  static base::Version CurrentVersion();
+  // The page listing all releases.
+  static GURL ReleasesPageUrl();
+
+  // Starts a check unless one ran recently or is running. `force` skips the
+  // "recently" part.
+  void Check(bool force);
+
+  State state() const { return state_; }
+  // Published releases, newest first.
+  const std::vector<ArchieRelease>& releases() const { return releases_; }
+  // The newest release if it is newer than the running version.
+  const ArchieRelease* GetAvailableUpdate() const;
+
+  // `callback` runs whenever state() or releases() change.
+  base::CallbackListSubscription RegisterCallback(
+      base::RepeatingClosure callback);
+
+ private:
+  friend class base::NoDestructor<ArchieUpdateChecker>;
+
+  ArchieUpdateChecker();
+  ~ArchieUpdateChecker();
+
+  void OnDownloaded(std::optional<std::string> response_body);
+  void SetState(State state);
+
+  State state_ = State::kNotChecked;
+  std::vector<ArchieRelease> releases_;
+  base::TimeTicks last_check_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::RepeatingTimer periodic_check_;
+  base::RepeatingClosureList callbacks_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARCHIE_UPDATE_CHECKER_H_
diff --git a/chrome/browser/ui/views/tabs/vertical/archie_update_checker.cc b/chrome/browser/ui/views/tabs/vertical/archie_update_checker.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/vertical/archie_update_checker.cc
@@ -0,0 +1,201 @@
+// Copyright 2026 The Archie Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/archie_update_checker.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/ui/views/tabs/vertical/archie_version.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+
+namespace {
+
+// Don't ask GitHub more often than this, however many windows open.
+constexpr base::TimeDelta kMinCheckInterval = base::Hours(1);
+constexpr base::TimeDelta kPeriodicCheckInterval = base::Hours(6);
+constexpr size_t kMaxResponseSize = 1024 * 1024;
+constexpr int kMaxReleases = 30;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("archie_update_check", R"(
+      semantics {
+        sender: "Archie update check"
+        description:
+          "Fetches the list of Archie releases from the project's GitHub "
+          "repository, to tell the user when a newer version is available "
+          "and to show patch notes."
+        trigger:
+          "When a browser window opens (at most once an hour), every six "
+          "hours, and when the user picks 'Check for updates'."
+        data: "None. The request carries no cookies or user data."
+        destination: OTHER
+        destination_other: "api.github.com"
+        user_data { type: NONE }
+        last_reviewed: "2026-10-27"
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "None."
+        policy_exception_justification: "Not implemented."
+      })");
+
+std::u16string StringOrEmpty(const base::DictValue& dict,
+                             std::string_view key) {
+  const std::string* value = dict.FindString(key);
+  return value ? base::UTF8ToUTF16(*value) : std::u16string();
+}
+
+}  // namespace
+
+ArchieRelease::ArchieRelease() = default;
+ArchieRelease::ArchieRelease(const ArchieRelease&) = default;
+ArchieRelease& ArchieRelease::operator=(const ArchieRelease&) = default;
+ArchieRelease::~ArchieRelease() = default;
+
+// static
+ArchieUpdateChecker* ArchieUpdateChecker::Get() {
+  static base::NoDestructor<ArchieUpdateChecker> instance;
+  return instance.get();
+}
+
+ArchieUpdateChecker::ArchieUpdateChecker() = default;
+ArchieUpdateChecker::~ArchieUpdateChecker() = default;
+
+// static
+base::Version ArchieUpdateChecker::CurrentVersion() {
+  return base::Version(kArchieVersion);
+}
+
+// static
+GURL ArchieUpdateChecker::ReleasesPageUrl() {
+  return GURL(
+      base::StrCat({"https://github.com/", kArchieUpdateRepo, "/releases"}));
+}
+
+void ArchieUpdateChecker::Check(bool force) {
+  if (state_ == State::kChecking || !g_browser_process) {
+    return;
+  }
+  if (!force && !last_check_.is_null() &&
+      base::TimeTicks::Now() - last_check_ < kMinCheckInterval) {
+    return;
+  }
+  if (!periodic_check_.IsRunning()) {
+    periodic_check_.Start(
+        FROM_HERE, kPeriodicCheckInterval,
+        base::BindRepeating(&ArchieUpdateChecker::Check,
+                            base::Unretained(this), /*force=*/false));
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(base::StrCat({"https://api.github.com/repos/",
+                                    kArchieUpdateRepo, "/releases?per_page=",
+                                    base::NumberToString(kMaxReleases)}));
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader("Accept", "application/vnd.github+json");
+
+  last_check_ = base::TimeTicks::Now();
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  // The checker lives for the whole browser process.
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&ArchieUpdateChecker::OnDownloaded,
+                     base::Unretained(this)),
+      kMaxResponseSize);
+  SetState(State::kChecking);
+}
+
+const ArchieRelease* ArchieUpdateChecker::GetAvailableUpdate() const {
+  if (releases_.empty()) {
+    return nullptr;
+  }
+  const base::Version current = CurrentVersion();
+  const ArchieRelease& newest = releases_.front();
+  return current.IsValid() && newest.version.CompareTo(current) > 0 ? &newest
+                                                                    : nullptr;
+}
+
+base::CallbackListSubscription ArchieUpdateChecker::RegisterCallback(
+    base::RepeatingClosure callback) {
+  return callbacks_.Add(std::move(callback));
+}
+
+void ArchieUpdateChecker::OnDownloaded(
+    std::optional<std::string> response_body) {
+  loader_.reset();
+  // GitHub's JSON is parsed in-process with Chromium's memory-safe (Rust)
+  // JSON parser.
+  std::optional<base::ListValue> list =
+      response_body ? base::JSONReader::ReadList(*response_body,
+                                                 base::JSON_PARSE_RFC)
+                    : std::nullopt;
+  if (!list) {
+    SetState(State::kFailed);
+    return;
+  }
+
+  std::vector<ArchieRelease> releases;
+  for (const base::Value& item : *list) {
+    const base::DictValue* dict = item.GetIfDict();
+    if (!dict || dict->FindBool("draft").value_or(false) ||
+        dict->FindBool("prerelease").value_or(false)) {
+      continue;
+    }
+    const std::string* tag = dict->FindString("tag_name");
+    if (!tag) {
+      continue;
+    }
+    // Tags look like "v1.2.3".
+    std::string_view version_string = *tag;
+    if (base::StartsWith(version_string, "v") ||
+        base::StartsWith(version_string, "V")) {
+      version_string.remove_prefix(1);
+    }
+    ArchieRelease release;
+    release.version = base::Version(version_string);
+    if (!release.version.IsValid()) {
+      continue;
+    }
+    release.title = StringOrEmpty(*dict, "name");
+    if (release.title.empty()) {
+      release.title = base::UTF8ToUTF16(*tag);
+    }
+    release.date = StringOrEmpty(*dict, "published_at").substr(0, 10);
+    release.notes = StringOrEmpty(*dict, "body");
+    const std::string* url = dict->FindString("html_url");
+    release.url = url ? GURL(*url) : ReleasesPageUrl();
+    if (!release.url.SchemeIs("https")) {
+      release.url = ReleasesPageUrl();
+    }
+    releases.push_back(std::move(release));
+  }
+
+  std::stable_sort(releases.begin(), releases.end(),
+                   [](const ArchieRelease& a, const ArchieRelease& b) {
+                     return a.version.CompareTo(b.version) > 0;
+                   });
+  releases_ = std::move(releases);
+  SetState(State::kDone);
+}
+
+void ArchieUpdateChecker::SetState(State state) {
+  state_ = state;
+  callbacks_.Notify();
+}
