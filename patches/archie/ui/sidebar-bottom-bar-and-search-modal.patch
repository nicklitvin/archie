+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "components/omnibox/browser/autocomplete_classifier.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "third_party/metrics_proto/omnibox_event.pb.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/font_list.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/bubble/bubble_border.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/controls/textfield/textfield.h"
+
+namespace {
+
+constexpr char16_t kPlaceholder[] = u"Search or type a URL";
+constexpr int kFontSizeDelta = 4;
+constexpr int kWidthInChars = 40;
+
+}  // namespace
+
+ArchieCommandBar::ArchieCommandBar(BrowserWindowInterface* browser)
+    : browser_(browser) {}
+
+ArchieCommandBar::~ArchieCommandBar() {
+  if (widget_) {
+    widget_->CloseNow();
+  }
+}
+
+void ArchieCommandBar::Show(views::View* anchor) {
+  if (widget_) {
+    widget_->Activate();
+    textfield_->RequestFocus();
+    return;
+  }
+
+  delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+      anchor, views::BubbleBorder::FLOAT);
+  delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate_->SetShowTitle(false);
+  delegate_->SetShowCloseButton(false);
+
+  auto textfield = std::make_unique<views::Textfield>();
+  textfield->SetController(this);
+  textfield->SetPlaceholderText(kPlaceholder);
+  textfield->GetViewAccessibility().SetName(std::u16string(kPlaceholder));
+  textfield->SetFontList(
+      views::Textfield::GetDefaultFontList().DeriveWithSizeDelta(
+          kFontSizeDelta));
+  textfield->SetDefaultWidthInChars(kWidthInChars);
+  textfield_ = delegate_->SetContentsView(std::move(textfield));
+  delegate_->SetInitiallyFocusedView(textfield_);
+
+  widget_ = views::BubbleDialogDelegate::CreateBubble(
+      delegate_.get(), base::BindOnce(&ArchieCommandBar::OnWidgetClosed,
+                                      weak_factory_.GetWeakPtr()));
+  widget_->Show();
+}
+
+bool ArchieCommandBar::HandleKeyEvent(views::Textfield* sender,
+                                      const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed ||
+      key_event.key_code() != ui::VKEY_RETURN) {
+    return false;
+  }
+  OpenInNewTab(sender->GetText());
+  return true;
+}
+
+void ArchieCommandBar::OpenInNewTab(std::u16string_view input) {
+  const std::u16string text(base::TrimWhitespace(input, base::TRIM_ALL));
+  if (text.empty()) {
+    return;
+  }
+
+  // Let the omnibox decide whether this is an address or a search, exactly as
+  // if it had been typed into the location bar.
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile())
+      ->Classify(text, /*in_keyword_mode=*/false,
+                 /*allow_exact_keyword_match=*/false,
+                 metrics::OmniboxEventProto::INVALID_SPEC, &match,
+                 /*alternate_nav_url=*/nullptr);
+  if (!match.destination_url.is_valid()) {
+    return;
+  }
+
+  NavigateParams params(browser_.get(), match.destination_url,
+                        match.transition);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+
+  // Closes asynchronously, so it is safe while handling the textfield's event.
+  // The new tab may already have closed it by taking activation.
+  if (widget_) {
+    widget_->Close();
+  }
+}
+
+void ArchieCommandBar::OnWidgetClosed(views::Widget::ClosedReason reason) {
+  if (textfield_) {
+    textfield_->SetController(nullptr);
+    textfield_ = nullptr;
+  }
+  // The widget may still be unwinding, and the delegate must outlive it, so
+  // destroy both later, widget first.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::unique_ptr<views::BubbleDialogDelegate> delegate,
+             std::unique_ptr<views::Widget> widget) { widget.reset(); },
+          std::move(delegate_), std::move(widget_)));
+}
