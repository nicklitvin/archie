+// Archie: the floating search box shown by the sidebar's new tab button.
+// Typing an address opens it; anything else is searched with the default
+// search engine. Enter opens the result in a new tab, Esc or clicking
+// elsewhere closes the box without opening a tab.
+class ArchieCommandBar : public views::TextfieldController {
+ public:
+  explicit ArchieCommandBar(BrowserWindowInterface* browser);
+  ArchieCommandBar(const ArchieCommandBar&) = delete;
+  ArchieCommandBar& operator=(const ArchieCommandBar&) = delete;
+  ~ArchieCommandBar() override;
+
+  // Shows the search box centred over `anchor`, or refocuses it if it is
+  // already open.
+  void Show(views::View* anchor);
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+ private:
+  void OpenInNewTab(std::u16string_view input);
+  void OnWidgetClosed(views::Widget::ClosedReason reason);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+
+  // The delegate must outlive `widget_`, so it is declared first.
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::Textfield> textfield_ = nullptr;
+
+  base::WeakPtrFactory<ArchieCommandBar> weak_factory_{this};
+};
