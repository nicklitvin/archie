+class BubbleDialogDelegate;
+class LabelButton;
+class Textfield;
+class View;
+}  // namespace views
+
+// Archie: the floating search box shown by the sidebar's new tab button.
+// It suggests addresses, history, bookmarks and searches as you type, using
+// the same autocomplete engine as the address bar. Up/Down pick a suggestion,
+// Enter or a click opens it in a new tab, and Esc or clicking elsewhere
+// closes the box without opening a tab.
+class ArchieCommandBar : public views::TextfieldController,
+                         public AutocompleteController::Observer {
+ public:
+  explicit ArchieCommandBar(BrowserWindowInterface* browser);
+  ArchieCommandBar(const ArchieCommandBar&) = delete;
+  ArchieCommandBar& operator=(const ArchieCommandBar&) = delete;
+  ~ArchieCommandBar() override;
+
+  // Shows the search box centred over `anchor`, or refocuses it if it is
+  // already open.
+  void Show(views::View* anchor);
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override;
+
+ private:
+  void RebuildSuggestionRows();
+  void SelectRow(int row);
+  void OnRowPressed(size_t row);
+  void OpenMatch(const AutocompleteMatch& match);
+  // Used when Enter is pressed before any suggestion has arrived.
+  void OpenTypedText(std::u16string_view input);
+  void OnWidgetClosed(views::Widget::ClosedReason reason);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+
+  // The delegate must outlive `widget_`, so it is declared first.
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::Textfield> textfield_ = nullptr;
+  raw_ptr<views::View> suggestion_list_ = nullptr;
+  std::vector<raw_ptr<views::LabelButton>> suggestion_rows_;
+
+  std::unique_ptr<AutocompleteController> autocomplete_controller_;
+  base::ScopedObservation<AutocompleteController,
+                          AutocompleteController::Observer>
+      autocomplete_observation_{this};
+  // The suggestions currently shown, in row order.
+  std::vector<AutocompleteMatch> matches_;
+  int selected_row_ = -1;
+
+  base::WeakPtrFactory<ArchieCommandBar> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARCHIE_COMMAND_BAR_H_
