+
+  // Archie: never abbreviate titles. They wrap onto as many lines as needed,
+  // breaking inside words that are too long for one line (e.g. URLs). Top
+  // alignment keeps the first line in place when the layout gives the label
+  // less than its full height (e.g. while the sidebar is animating open), and
+  // the rest is clipped.
+  TabView().title_->SetElideBehavior(gfx::NO_ELIDE);
+  TabView().title_->SetMultiLine(true);
+  TabView().title_->SetMaxLines(0);
+  TabView().title_->SetAllowCharacterBreak(true);
+  TabView().title_->SetVerticalAlignment(gfx::ALIGN_TOP);
 }
 
