+  // Archie: let the title wrap. Top alignment keeps the first line in place
+  // when the layout gives the label less than its full height (e.g. while the
+  // sidebar is animating open), and the rest is clipped.
+  TabView().title_->SetElideBehavior(gfx::ELIDE_TAIL);
+  TabView().title_->SetMultiLine(true);
+  TabView().title_->SetMaxLines(kMaxTitleLines);
+  TabView().title_->SetVerticalAlignment(gfx::ALIGN_TOP);
